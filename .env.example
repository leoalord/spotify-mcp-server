# Spotify OAuth (Authorization Code + PKCE)
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional confidential-client credential. Keep this in .env or the OS keychain.
SPOTIFY_CLIENT_SECRET=

# Local MCP access. Generate a long random value; never reuse a Spotify token.
MCP_LOCAL_BEARER_TOKEN=

# Local server settings
MCP_HOST=127.0.0.1
MCP_PORT=8000
